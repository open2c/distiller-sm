def get_group_assembly(group_name):
    """Return the assembly name for a library group (all members share the same one)."""
    first_lib = config["input"]["library_groups"][group_name][0]
    return get_library_assembly(first_lib)


if "library_groups" in config["input"] and len(config["input"]["library_groups"]) > 0:
    # Validate that all libraries in a group share the same assembly
    for group_name, group_libs in config["input"]["library_groups"].items():
        group_assemblies = set(get_library_assembly(lib) for lib in group_libs)
        if len(group_assemblies) > 1:
            libs_by_assembly = {}
            for lib in group_libs:
                libs_by_assembly.setdefault(get_library_assembly(lib), []).append(lib)
            detail = "; ".join(
                f"{asm}: {libs}" for asm, libs in libs_by_assembly.items()
            )
            raise ValueError(
                f"Library group '{group_name}' mixes libraries with different reference "
                f"genomes and cannot be merged. Found: {detail}. "
                f"All libraries in a group must use the same genome (or the same "
                f"genomic view)."
            )

    for group_name in config["input"]["library_groups"].keys():
        grp_asm = get_group_assembly(group_name)
        library_group_coolers += expand(
            f"{coolers_library_group_folder}/{group_name}.{grp_asm}.{{filter_name}}.{min_resolution}.mcool",
            filter_name=list(config["bin"]["filters"].keys()),
        )
        if config["bin"].get("make_hic", False):
            library_group_hic += expand(
                f"{coolers_library_group_folder}/{group_name}.{grp_asm}.{{filter_name}}.{min_resolution}.hic",
                filter_name=list(config["bin"]["filters"].keys()),
            )
        library_group_stats.append(
            f"{stats_library_group_folder}/{group_name}.{grp_asm}.stats"
        )
    # library_group_scaling_pairs = expand(
    #     f"{stats_library_group_folder}/{{library_group}}.{assembly}.scaling.tsv",
    #     library_group=config["input"]["library_groups"].keys(),
    # )

