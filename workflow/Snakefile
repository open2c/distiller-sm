            ),
            dropseq_flag=("--drop-seq" if config["parse"].get("drop_seq", True) else ""),
            parsing_options=config["parse"].get("parsing_options", ""),
            pt=PT,
            stream_out=STREAM_OUT,
            stream_in=STREAM_IN,
            mem_args=f"{PT_MEM} {PT_TMP}".strip(),
        shell:
            r"""
            {params.pt} parse {params.dropsam_flag} {params.dropreadid_flag} {params.dropseq_flag} \
            {params.parsing_options} \
            -c {input.chromsizes} {params.stream_out} {input.bam} \
            | {params.pt} sort --nproc {threads} {params.mem_args} -o {output} {params.stream_in} \
            >{log[0]} 2>&1
            """

else:
    raise ValueError(f"Unknown mapper: {mapper}")


# Find out the chunk ids for each library and run - since we don't know them beforehand
def get_pair_chunks(wildcards):
    checkpoint_output = checkpoints.chunk_fastq.get(**wildcards).output
    chunk_ids = glob_wildcards(
        f"{processed_fastqs_folder}/{wildcards.library}/{wildcards.run}/2.{{chunk_id}}.fastq.gz",
    ).chunk_id
    lib_asm = get_library_assembly(wildcards.library)
    paths = expand(
        f"{mapped_parsed_sorted_chunks_folder}/{wildcards.library}/{wildcards.run}/{{chunk_id}}.{lib_asm}.{PAIRS_EXT}",
        chunk_id=chunk_ids,
    )
    return paths


rule merge_runs:
    input:
        get_pair_chunks,
    output:
        f"{pairs_runs_folder}/{{library}}/{{run}}.{{assembly_name}}.{PAIRS_EXT}",
    log:
        "logs/merge_runs/{library}.{run}.{assembly_name}.log",
    benchmark:
        "benchmarks/merge_runs/{library}.{run}.{assembly_name}.tsv"
    conda:
        PT_ENV
    threads: 4
    params:
        command=lambda wildcards, input, threads, output: (
            f"{PT} merge {input} --nproc {threads} {PT_MEM} {PT_TMP} -o {output}"
            if len(input) > 1
            else f"ln -srf {input} {output}"
        ),
    shell:
        r"""{params.command} \
        >{log[0]} 2>&1
        """


make_pairsam = config["parse"]["make_pairsam"]
save_bytile = config["dedup"].get("save_by_tile_dups", False)
do_phase = config.get("phase", {}).get("do_phase", False)

_lib_stem = f"{pairs_library_folder}/{{library}}.{{assembly_name}}"

# Named outputs, so that the shell commands below never index into a positional list.
# (The previous positional form wired --output-bytile-stats to the pairix index in the
# make_pairsam branch.)
merge_output = {
    "nodups": f"{_lib_stem}.nodups.{PAIRS_EXT}",
    "unmapped": f"{_lib_stem}.unmapped.{PAIRS_EXT}",
    "dups": f"{_lib_stem}.dups.{PAIRS_EXT}",
    "stats": f"{_lib_stem}.dedup.stats",
}
if make_pairsam:
    merge_output["nodups_bam"] = f"{_lib_stem}.nodups.bam"
    merge_output["unmapped_bam"] = f"{_lib_stem}.unmapped.bam"
    merge_output["dups_bam"] = f"{_lib_stem}.dups.bam"
    if PARQUET:
        # dedup cannot write its three outputs into process substitutions when they
        # are parquet (no seekable sink, and a >(…) fd path defeats the extension
        # based format detection), so split runs afterwards over real files.
        merge_output["nodups_pairsam"] = temp(f"{_lib_stem}.nodups.pairsam.parquet")
        merge_output["unmapped_pairsam"] = temp(f"{_lib_stem}.unmapped.pairsam.parquet")
        merge_output["dups_pairsam"] = temp(f"{_lib_stem}.dups.pairsam.parquet")
if not PARQUET:
    # Parquet cannot be bgzf-indexed, and nothing downstream of here reads a pairix
    # index, so it is only produced on the text path.
    merge_output["index"] = f"{_lib_stem}.nodups.pairs.gz.px2"
if save_bytile:
    merge_output["bytile"] = f"{_lib_stem}.by_tile_dups.txt"


def _dedup_pipeline(input, threads):
    """Everything piped into `dedup`, plus the input token `dedup` itself should read.

    Returns (prefix, dedup_input). `prefix` is either '' or a chain of commands
    ending in '| '. The first stage of the chain reads the input file(s); the rest
    read the stream.
    """
    files = str(input)
    side_nproc = max(1, threads - 1)
    tag_mode = config.get("phase", {}).get("tag_mode", "XA")
    suffixes = " ".join(config.get("phase", {}).get("suffixes", []))
    stages = []

    if PARQUET:
        if len(input) > 1:
            stages.append(
                f"{PT} merge {{src}} --nproc {threads} --keep-first-header "
                f"{PT_MEM} {PT_TMP} -o -.arrow"
            )
        if do_phase:
            stages.append(
                f"{PT} phase --tag-mode {tag_mode} --phase-suffixes {suffixes} "
                f"-o -.arrow {{src}}"
            )
            stages.append(
                f"{PT} sort --nproc {side_nproc} {PT_MEM} {PT_TMP} -o -.arrow {{src}}"
            )
    else:
        if len(input) > 1:
            stages.append(
                f"pairtools merge {{src}} --nproc {threads} --keep-first-header"
            )
        else:
            stages.append(f"bgzip -dc -@ {side_nproc} {{src}}")
        if do_phase:
            stages.append(
                f"pairtools phase --tag-mode {tag_mode} --phase-suffixes {suffixes}"
            )
            stages.append(f"pairtools sort --nproc {side_nproc}")

    if not stages:
        # Parquet, a single run, no phasing: hand dedup the file. This skips both the
        # decompression pass the text path needs and dedup's spooling of stdin to a
        # temporary parquet file.
        return "", files

    rendered = [
        stage.format(src=(files if i == 0 else STREAM_IN))
        for i, stage in enumerate(stages)
    ]
    return " | ".join(rendered) + " | ", STREAM_IN


# The dedup invocation itself, assembled at parse time.
if make_pairsam and not PARQUET:
    _dedup_outputs = (
        "--output >( pairtools split "
        "--output-pairs {output.nodups} --output-sam {output.nodups_bam} ) "
        "--output-unmapped >( pairtools split "
        "--output-pairs {output.unmapped} --output-sam {output.unmapped_bam} ) "
        "--output-dups >( pairtools split "
        "--output-pairs {output.dups} --output-sam {output.dups_bam} ) "
    )
elif make_pairsam and PARQUET:
    _dedup_outputs = (
        "--output {output.nodups_pairsam} "
        "--output-unmapped {output.unmapped_pairsam} "
        "--output-dups {output.dups_pairsam} "
    )
else:
    _dedup_outputs = (
        "--output {output.nodups} "
        "--output-unmapped {output.unmapped} "
        "--output-dups {output.dups} "
    )

_bytile_arg = (
    "--keep-parent-id --output-bytile-stats {output.bytile} " if save_bytile else ""
)
_backend_arg = (
    f"--backend {PT_DEDUP_BACKEND} -p {{threads}} {PT_MEM} {PT_TMP} " if PARQUET else ""
)

dedup_command = (
    "{params.pt} dedup {params.dedup_options} "
    "--max-mismatch {params.max_mismatch_bp} "
    "--mark-dups "
    + _backend_arg
    + _dedup_outputs
    + "--output-stats {output.stats} "
    + _bytile_arg
    + "{params.dedup_input}"
)

# Anything that has to happen after dedup.
_post_commands = []
if make_pairsam and PARQUET:
    for _kind in ("nodups", "unmapped", "dups"):
        _post_commands.append(
            f"{PT} split --output-pairs {{output.{_kind}}} "
            f"--output-sam {{output.{_kind}_bam}} {{output.{_kind}_pairsam}}"
        )
if not PARQUET:
    _post_commands.append("pairix {output.nodups}")

merge_dedup_command = dedup_command + " >{log[0]} 2>&1"
for _cmd in _post_commands:
    merge_dedup_command += f" && {_cmd} >>{{log[0]}} 2>&1"


rule merge_dedup:
    input:
        pairs=lambda wildcards: expand(
            f"{pairs_runs_folder}/{wildcards.library}/{{run}}.{wildcards.assembly_name}.{PAIRS_EXT}",
            run=list(LIBRARY_RUN_FASTQS[wildcards.library].keys()),
        ),
    output:
        **merge_output,
    log:
        "logs/merge_dedup/{library}.{assembly_name}.log",
    benchmark:
        "benchmarks/merge_dedup/{library}.{assembly_name}.tsv"
    conda:
        PT_ENV
    threads: 4
    params:
        pt=PT,
        dedup_options=lambda wildcards: config["dedup"].get("dedup_options", ""),
        max_mismatch_bp=config["dedup"]["max_mismatch_bp"],
        pipeline=lambda wildcards, input, threads: _dedup_pipeline(input, threads)[0],
        dedup_input=lambda wildcards, input, threads: _dedup_pipeline(input, threads)[1],
    shell:
        r"{params.pipeline}" + merge_dedup_command


def _cload_source(wildcards, input, threads):
    """Command emitting text .pairs on stdout for `cooler cload` to consume."""
    expression = config["bin"]["filters"][wildcards.filter_name]
    if PARQUET:
        # Omitting -o makes pairtools_parquet write text to stdout.
        if expression:
            return f'{PT} select "{expression}" {input.pairs}'
        return f"{PT} parquet-to-csv --nproc {threads} {input.pairs}"
    decompress = f"bgzip -dc -@ {max(1, threads - 1)} {input.pairs}"
    if expression:
        return f'{decompress} | pairtools select "{expression}"'
    return decompress


rule bin_pairs_library:
    input:
        pairs=f"{pairs_library_folder}/{{library}}.{{assembly_name}}.nodups.{PAIRS_EXT}",
        chromsizes=get_library_chromsizes,
    output:
        cool=f"{coolers_library_folder}/{{library}}.{{assembly_name}}.{{filter_name}}.{{min_resolution}}.cool",
    log:
        "logs/bin_pairs_library/{library}.{assembly_name}.{filter_name}.{min_resolution}.log",
    benchmark:
        "benchmarks/bin_pairs_library/{library}.{assembly_name}.{filter_name}.{min_resolution}.tsv"
    conda:
        PT_ENV
    threads: 4
    params:
        source=_cload_source,
    shell:
        r"""
        {params.source} | cooler cload pairs -c1 2 -p1 3 -c2 4 -p2 5 \
        --assembly {wildcards.assembly_name} \
        {input.chromsizes}:{wildcards.min_resolution} - {output.cool} >{log[0]} 2>&1
        """


