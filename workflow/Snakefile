# ---- Per-library genome rearrangement using viewtools ----
# If a library has a genomic view defined, rearrange the reference genome
# to create a custom FASTA for that library. The rearranged FASTA and its
# indexes are marked temp() to save disk space.

if genomic_views:

    rule rearrange_genome:
        input:
            genome=genome_path,
            view=lambda wildcards: genomic_views[wildcards.library],
        output:
            genome=_maybe_temp(f"{view_genomes_folder}/{{library}}.{assembly}.fa"),
        log:
            f"logs/rearrange_genome/{{library}}.{assembly}.log",
        conda:
            "envs/viewtools.yml"
        threads: 1
        shell:
            r"""
            viewtools rearrange-genome {input.genome} \
            --view {input.view} \
            --out {output.genome} \
            >{log} 2>&1
            """


# ---- Genome chromsizes and mapper index ----
# One rule body per mapper/tool, written once against the per-library
# (view) genome path and reused for the shared genome via `use rule ... as
# ... with:` so the shell/wrapper logic isn't duplicated between the two
# genome scenarios. The view-genome outputs stay temp()-wrapped (subject to
# keep_view_genomes); the shared-genome outputs are always kept.


rule make_view_chromsizes:
    input:
        genome_fasta=f"{view_genomes_folder}/{{library}}.{assembly}.fa",
    output:
        chromsizes=f"{view_genomes_folder}/{{library}}.{assembly}.chromsizes",
    log:
        f"logs/make_view_chromsizes/{{library}}.{assembly}.log",
    conda:
        "envs/chromsize.yml"
    threads: 1
    shell:
        r"""
        chromsize --sequence {input.genome_fasta} -o $(dirname {output.chromsizes}) -p $(basename {output.chromsizes}) -t {threads} \
        >{log} 2>&1
        """


use rule make_view_chromsizes as make_chromsizes with:
    input:
        genome_fasta=genome_path,
    output:
        chromsizes=chromsizes_path,
    log:
        f"logs/make_chromsizes/{assembly}.log",


if mapper == "chromap":

    rule chromap_index:
        input:
            genome=f"{view_genomes_folder}/{{library}}.{assembly}.fa",
        output:
            idx=_maybe_temp(
                f"{view_genomes_folder}/{{library}}.{assembly}.fa.chromap.index"
            ),
        log:
            f"logs/chromap_index/{{library}}.{assembly}.log",
        conda:
            "envs/chromap.yml"
        shell:
            r"chromap -i -r {input.genome} -o {output.idx} >{log} 2>&1"

    use rule chromap_index as chromap_index_global with:
        input:
            genome=genome_path,
        output:
            idx=genome_path + ".chromap.index",
        log:
            f"logs/chromap_index/{assembly}.log",

elif mapper in ("bwa-mem", "bwa-mem2", "bwa-meme", "bwa-mem3"):

    rule bwaindex:
        input:
            genome=f"{view_genomes_folder}/{{library}}.{assembly}.fa",
        output:
            idx=_maybe_temp(
                multiext(f"{view_genomes_folder}/{{library}}.{assembly}.fa", *IDX_EXTS)
            ),
        log:
            f"logs/bwaindex/{{library}}.{assembly}.log",
        cache: True
        threads: 1  #Only affects bwa-meme
        params:
            bwa=mapper,
        wrapper:
            "v9.9.0/bio/bwa-memx/index"

    use rule bwaindex as bwaindex_global with:
        input:
            genome=genome_path,
        output:
            idx=multiext(genome_path, *IDX_EXTS),
        log:
            f"logs/bwaindex/{assembly}.log",

elif mapper == "minibwa":

    rule minibwaindex:
