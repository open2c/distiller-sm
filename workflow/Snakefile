#####################################################################
# Pairs-processing backend: 'pairtools' (text) or 'parquet' (columnar)
#####################################################################
PT_CFG = config.get("pairtools", {}) or {}
PT_BACKEND = PT_CFG.get("backend", "pairtools")
if PT_BACKEND not in ("pairtools", "parquet"):
    raise ValueError(
        f"Unknown pairtools backend: {PT_BACKEND!r}. "
        "Set config['pairtools']['backend'] to 'pairtools' or 'parquet'."
    )
PARQUET = PT_BACKEND == "parquet"

# The executable, and the on-disk format of every intermediate pairs file.
PT = "pairtools_parquet" if PARQUET else "pairtools"
PAIRS_EXT = "parquet" if PARQUET else "pairs.gz"
PT_ENV = "envs/pairtools_parquet_cooler.yml" if PARQUET else "envs/pairtools_cooler.yml"

# Parquet writes its footer last, so it cannot travel through a pipe. The Arrow IPC
# *stream* format has no footer and can, so that is what we pipe between stages.
# pairtools_parquet follows pairtools' convention: omitting -o writes to stdout and
# omitting the input path reads stdin, with '-' saying either explicitly.
STREAM_OUT = "-o -.arrow" if PARQUET else ""
STREAM_IN = "-" if PARQUET else ""

PT_MEM = f"--memory {PT_CFG['memory']}" if PARQUET and PT_CFG.get("memory") else ""
PT_TMP = f"--tmpdir {PT_CFG['tmpdir']}" if PARQUET and PT_CFG.get("tmpdir") else ""
PT_DEDUP_BACKEND = PT_CFG.get("dedup_backend", "duckdb")
if PARQUET and PT_DEDUP_BACKEND not in ("duckdb", "scipy", "sklearn"):
    raise ValueError(
        f"Unknown dedup backend: {PT_DEDUP_BACKEND!r}. "
        "pairtools_parquet supports 'duckdb', 'scipy' and 'sklearn' "
        "(pairtools' 'cython' backend is not available)."
    )
if PARQUET and "--backend cython" in config.get("dedup", {}).get("dedup_options", ""):
    raise ValueError(
        "pairtools_parquet does not implement the 'cython' dedup backend. "
        "Use config['pairtools']['dedup_backend'] ('duckdb', 'scipy' or 'sklearn') "
        "instead of passing --backend in dedup_options."
    )
export_text_pairs = PARQUET and PT_CFG.get("export_text_pairs", False)


# Optional user-provided rules. Absent by default.
