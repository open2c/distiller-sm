# The workflow is composed almost entirely out of shell pipes. Without pipefail a
# failing upstream stage (e.g. pairtools parse) is masked by a succeeding downstream
# stage (e.g. pairtools sort), and the rule exits 0 with truncated output.
shell.prefix("set -eo pipefail; ")


localrules:
    merge_stats_libraries_into_groups,


downloaded_fastqs_folder = config["output"]["dirs"]["downloaded_fastqs"]
