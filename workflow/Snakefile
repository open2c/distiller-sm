        {input.mcool} {output.hic} >{log} 2>&1
        """


use rule mcool2hic_group as mcool2hic_library with:
    input:
        mcool=f"{coolers_library_folder}/{{library}}.{{assembly_name}}.{{filter_name}}.{{min_resolution}}.mcool",
    output:
        hic=f"{coolers_library_folder}/{{library}}.{{assembly_name}}.{{filter_name}}.{{min_resolution}}.hic",
    log:
        "logs/mcool2hic/{library}.{assembly_name}.{filter_name}.{min_resolution}.log",
    benchmark:
        r"benchmarks/mcool2hic/{library}.{assembly_name}.{filter_name}.{min_resolution}.tsv"


rule scaling_pairs_library:
    input:
        pairs=f"{pairs_library_folder}/{{library}}.{{assembly_name}}.nodups.{PAIRS_EXT}",
        chromsizes=get_library_chromsizes,
    output:
        scaling=f"{pairs_library_folder}/{{library}}.{{assembly_name}}.nodups.scaling.tsv",
    log:
        "logs/scaling_pairs_library/{library}.{assembly_name}.log",
    benchmark:
        "benchmarks/scaling_pairs_library/{library}.{assembly_name}.tsv"
    conda:
        PT_ENV
    threads: 4
    params:
        min_distance=config["scaling_pairs"].get("min_distance", 0),
        max_distance=lambda wildcards, input: (
            config["scaling_pairs"]["max_distance"]
            if config["scaling_pairs"].get("max_distance")
            else pd.read_table(input.chromsizes, header=None, names=["chrom", "size"])[
                "size"
            ].max()
        ),
        n_dist_bins_decade=config["scaling_pairs"].get("n_dist_bins_decade", 10),
        extra=config["scaling_pairs"].get("scaling_options", ""),
        # `pairtools_parquet scaling` does not build its default view from the
        # #chromsize: header lines the way `pairtools scaling` does. It emits end=-1
        # for every region and therefore n_bp2=0 -- and n_bp2 is the area P(s) is
        # normalised by, so the output is unusable without it. This is not a parquet
        # problem: it reproduces with text input too. Passing an explicit --view
        # built from the chromsizes fixes n_bp2, but also changes n_pairs (pairtools
        # itself counts differently with a view than without: 15631 vs 17044 on the
        # test data), so it does not reproduce the current output either.
        #
        # Until that is fixed upstream, convert to text and use pairtools' own
        # scaling, which is byte-identical to the text backend. Scaling is a cheap
        # step, so the conversion costs little.
        source=lambda wildcards, input, threads: (
            f"{PT} parquet-to-csv --nproc {threads} {input.pairs} | pairtools"
            if PARQUET
            else "pairtools"
        ),
        pairs_arg=lambda wildcards, input: "-" if PARQUET else str(input.pairs),
    shell:
        r"""
        {params.source} scaling \
        --dist-range {params.min_distance} {params.max_distance} \
        --n-dist-bins-decade {params.n_dist_bins_decade} \
        {params.extra} \
        -o {output.scaling} \
        {params.pairs_arg} \
        >{log[0]} 2>&1
        """


if export_text_pairs:

    rule export_text_pairs:
        input:
            pairs=f"{pairs_library_folder}/{{library}}.{{assembly_name}}.nodups.parquet",
        output:
            pairs=f"{pairs_library_folder}/{{library}}.{{assembly_name}}.nodups.pairs.gz",
            index=f"{pairs_library_folder}/{{library}}.{{assembly_name}}.nodups.pairs.gz.px2",
        log:
            "logs/export_text_pairs/{library}.{assembly_name}.log",
        benchmark:
            "benchmarks/export_text_pairs/{library}.{assembly_name}.tsv"
        conda:
            PT_ENV
        threads: 4
        params:
            pt=PT,
        shell:
            # parquet-to-csv's own .gz is pigz, not bgzf, so pairix could not index
            # it. Pipe through real bgzip instead.
            r"""
            {params.pt} parquet-to-csv --nproc {threads} {input.pairs} \
            2>{log[0]} | bgzip -@ {threads} > {output.pairs}
            pairix {output.pairs} >>{log[0]} 2>&1
            """


